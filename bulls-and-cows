#!/bin/bash
trap 'echo; echo "Для выхода введите q или Q"' SIGINT

cat <<'BANNER'
********************************************************************************
* Я загадал 4-значное число с неповторяющимися цифрами. На каждом ходу делайте *
* попытку отгадать загаданное число. Попытка - это 4-значное число с           *
* неповторяющимися цифрами.                                                    *
********************************************************************************

BANNER

secret=""

while (( ${#secret} < 4 ))
do
    digit=${RANDOM: -1}

    if (( ${#secret} == 0 && digit == 0 ))
        then
            continue
    fi

    if [[ "${secret}" == *"${digit}"* ]]
        then
            continue
    fi

    secret+="${digit}"
done

declare -i step=1
declare -a history

while :
do
    read -p "Попытка ${step}: " input

    case "${input}" in
        [1-9][0-9][0-9][0-9])
        ;;
        q|Q)
            exit 1
        ;;
        *)
            echo "Ошибка: введите 4-значное число с неповторяющимися цифрами"
            continue
        ;;
    esac

    unique=1

    for (( i=0; i<4; i++ ))
    do
        if [[ "${input:i+1}" == *"${input:i:1}"* ]]
            then
                unique=0
        fi
    done

    if (( unique == 0 ))
        then
            echo "Ошибка: введите 4-значное число с неповторяющимися цифрами"
            continue
    fi

    declare -i cows=0
    declare -i bulls=0

    for (( i=0; i<4; i++ ))
    do
        if [[ "${input:i:1}" == "${secret:i:1}" ]]
            then
                bulls+=1
        elif [[ "${secret}" == *"${input:i:1}"* ]]
            then
                cows+=1
        fi
    done

    echo "Коров - ${cows} Быков - ${bulls}"
    echo

    history+=("${step}. ${input} (Коров - ${cows} Быков - ${bulls})")

    echo "История ходов:"
    for line in "${history[@]}"
    do
        echo "${line}"
    done
    echo

    if (( bulls == 4 ))
        then
            echo "Вы угадали число ${secret}!"
            exit 0
    fi

    step+=1
done
